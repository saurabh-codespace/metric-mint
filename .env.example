# Copy this file to .env and provide local values. Never commit .env.

# SQL Server
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=ToscanaInsightHub;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=

# Backend
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8090
DEMO_USERNAME=admin
DEMO_PASSWORD=admin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_DEMO_USER=admin
VITE_DEMO_PASSWORD=admin

# Optional OpenAI dashboard insights
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
